use Test;

my $s1 = q:to/HERE/;
=begin rakudoc
I am fully Rakudoc capable!
=end rakudoc
HERE

# create a Rakudoc file with spurt
my $tdir;
$tdir = "/tmp/mine";
mkdir "/tmp/mine" unless $tdir.IO.d;
my $fil = "/tmp/mine/pod";
unlink $fil if $fil.IO.e;
spurt $fil.IO, $s1;

my $proc = run "raku", "--doc=Markdown", $fil, :out, :err;
my $out = $proc.out.slurp(:close);
my $err = $proc.err.slurp: :close;
my $e   = $proc.exitcode;
say "exitcode: $e";
say "out: $out";
say "err: $err";


done-testing;



=finish
lives-ok {
}
my @rakudoc = load $r;
my $rakudoc = @rakudoc.head;
my @s = $rakudoc.contents;
is @s.elems, 1;
my $s = @s.head;
isa-ok $s, Pod::Block::Para;
say $s;
say $s.gist;
my @lines = $s.gist.lines;
isa-ok @lines, List;
for @lines.kv -> $i, $v {
    say "line $i: '$v'";
}
my $str = @lines.tail.trim;
my $exp = "I am fully Rakudoc capable!", 
is $str, $exp;

done-testing;
