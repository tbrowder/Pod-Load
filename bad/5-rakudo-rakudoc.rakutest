use Test;

my $s1 = "=begin rakudoc\nI am fully Rakudoc capable!\n=end rakudoc";
my $s2 = "=begin pod\nI am fully Rakudoc capable!\n=end pod";

# create a Rakudoc file with spurt
my $tdir;
$tdir = "/tmp/mine";
mkdir "/tmp/mine" unless $tdir.IO.d;
my $f1 = "/tmp/mine/my.rakudoc";
my $f2 = "/tmp/mine/my.pod";
unlink $f1 if $f1.IO.e;
unlink $f2 if $f2.IO.e;
spurt $f1.IO, $s1;
spurt $f2.IO, $s2;

my $p1 = run "raku", "--doc=Markdown", $f1, :out, :err;
my $out1 = $p1.out.slurp(:close);
my $err1 = $p1.err.slurp: :close;
my $e1   = $p1.exitcode;
say "exitcode1: $e1";
say "out1:\n$out1";
say "err1:\n$err1";


done-testing;



=finish
lives-ok {
}
my @rakudoc = load $r;
my $rakudoc = @rakudoc.head;
my @s = $rakudoc.contents;
is @s.elems, 1;
my $s = @s.head;
isa-ok $s, Pod::Block::Para;
say $s;
say $s.gist;
my @lines = $s.gist.lines;
isa-ok @lines, List;
for @lines.kv -> $i, $v {
    say "line $i: '$v'";
}
my $str = @lines.tail.trim;
my $exp = "I am fully Rakudoc capable!", 
is $str, $exp;

done-testing;
